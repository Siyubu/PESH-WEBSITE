# Copy to .env and edit:  cp .env.example .env

# --- Database ---
POSTGRES_DB=pesh
POSTGRES_USER=pesh
POSTGRES_PASSWORD=change-me

# --- Django ---
# Local testing: DJANGO_DEBUG=1. In production set DJANGO_DEBUG=0 and a long random DJANGO_SECRET_KEY
# (generate one: python3 -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
SITE_URL=http://localhost:8080
# Production behind HTTPS: set both to 1
SECURE_COOKIES=0
BEHIND_HTTPS_PROXY=0

# Optional: create an admin user on first start
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Email (password reset). Leave EMAIL_HOST empty to print emails in the backend log. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PESH <no-reply@yourdomain.org>

# --- Certificates and MTN MoMo ---
CERTIFICATE_PRICE=20000
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
# The MoMo sandbox only supports EUR. Use RWF in production.
MOMO_CURRENCY=EUR
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# Set to 1 once SITE_URL is a public https address MoMo can reach
MOMO_USE_CALLBACK=0
